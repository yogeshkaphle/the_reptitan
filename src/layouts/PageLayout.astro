---
// PageLayout wraps BaseLayout and adds the main element.
// Use for all pages that need the standard footer + sticky WA.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noIndex?: boolean;
  schema?: Record<string, unknown>;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <main>
    <slot />
  </main>
</BaseLayout>
