---
import '@/styles/global.css';
import BaseHead from '@/components/layout/BaseHead.astro';
import Footer from '@/components/layout/Footer.astro';
import SchemaOrg from '@/components/seo/SchemaOrg.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noIndex?: boolean;
  schema?: Record<string, unknown>;
  waMessage?: string;
}

const { title, description, ogImage, noIndex, schema, waMessage } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead {title} {description} {ogImage} {noIndex} />
    {schema && <SchemaOrg {schema} />}
  </head>
  <body class="min-h-screen bg-black text-stone">
    <slot />
    <Footer waMessage={waMessage} />
  </body>
</html>
