---
import PageLayout from '@/layouts/PageLayout.astro';
import { SITE, waLink } from '@/data/site';
import { getCollection } from 'astro:content';
import Badge from '@/components/ui/Badge.astro';
import CTAButton from '@/components/ui/CTAButton.astro';

const sorted = (await getCollection('leaks'))
  .sort((a, b) => (a.data.order ?? a.data.number ?? 99) - (b.data.order ?? b.data.number ?? 99));

const lessons = await Promise.all(
  sorted.map(async (lesson) => {
    const { Content } = await lesson.render();
    return { lesson, Content };
  })
);
---

<PageLayout
  title={`You're In — ${SITE.brand}`}
  description="Check your WhatsApp. Your free pull-up training is on the way."
  noIndex={true}
>
  <!-- Confirmation -->
  <section class="section bg-black" aria-label="Confirmation">
    <div class="container mx-auto max-w-2xl text-center">
      <Badge variant="sand" class="mb-4">You're in</Badge>
      <h1 class="headline text-4xl sm:text-5xl md:text-6xl">
        Lessons on<br />the way
      </h1>
      <p class="mt-5 text-stone">
        [PLACEHOLDER: Confirmation message. Warm, direct. Tell them to check WhatsApp — the lessons will arrive there. Also available below to watch now.]
      </p>
      <p class="mt-3 text-sm text-stone/60">
        Didn't get it? DM <a href={SITE.instagram} class="text-sand hover:underline" target="_blank" rel="noopener noreferrer">@the_reptitan</a> on Instagram.
      </p>
    </div>
  </section>

  <!-- Lesson accordion -->
  <section class="section bg-black-2" aria-label="Mini-course — 8 lessons">
    <div class="container mx-auto">
      <p class="eyebrow mb-6 text-center">Mini-course — 8 lessons</p>

      <div class="mx-auto max-w-[720px] space-y-2">
        {lessons.map(({ lesson, Content }, i) => {
          const isFirst = i === 0;
          const label = lesson.data.displayLabel
            ?? (lesson.data.number !== undefined ? `Lesson ${lesson.data.number}` : '');
          const vimeoSrc = lesson.data.videoId
            ? `https://player.vimeo.com/video/${lesson.data.videoId}?dnt=1&badge=0&autopause=0&player_id=0&app_id=58479&title=0&byline=0&portrait=0`
            : '';

          return (
            <details
              id={`lesson-card-${lesson.data.order ?? lesson.data.number ?? i}`}
              class="lesson-card group overflow-hidden rounded-lg border border-white/10 border-l-4 border-l-transparent bg-black-2 transition-colors open:border-white/20 open:border-l-sand open:bg-sand/5"
              open={isFirst || undefined}
            >
              <summary class="flex cursor-pointer list-none items-center gap-3 px-5 py-4 select-none">
                <!-- Label badge -->
                <span class="flex-shrink-0 font-mono text-xs uppercase tracking-widest text-blood">
                  {label}
                </span>

                <!-- Title + duration -->
                <div class="flex min-w-0 flex-1 flex-col gap-0.5 sm:flex-row sm:items-baseline sm:gap-3">
                  <h2 class="font-display text-lg uppercase tracking-display text-bone leading-none sm:text-xl">
                    {lesson.data.title}
                  </h2>
                  {lesson.data.length && (
                    <span class="font-mono text-xs text-stone/50">{lesson.data.length}</span>
                  )}
                </div>

                <!-- Play / chevron indicator -->
                <span class="flex-shrink-0 flex items-center gap-1.5 font-mono text-xs uppercase tracking-wide text-sand group-open:text-stone/50">
                  <span class="group-open:hidden">Play</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="transition-transform group-open:rotate-180"
                    aria-hidden="true"
                  >
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </span>
              </summary>

              <!-- Expanded body -->
              <div class="px-5 pb-6 pt-1">
                <!-- Description from Markdown body -->
                <div class="prose prose-sm prose-invert mb-5 max-w-none text-stone">
                  <Content />
                </div>

                <!-- Vimeo embed or dev placeholder -->
                {vimeoSrc ? (
                  <div class="aspect-video-16-9 overflow-hidden rounded-lg bg-black">
                    <iframe
                      src={isFirst ? vimeoSrc : undefined}
                      data-src={isFirst ? undefined : vimeoSrc}
                      class="h-full w-full"
                      frameborder="0"
                      allow="autoplay; fullscreen; picture-in-picture"
                      allowfullscreen
                      title={`${label}: ${lesson.data.title}`}
                    />
                  </div>
                ) : (
                  <div class="flex aspect-video-16-9 items-center justify-center rounded-lg border border-dashed border-white/20 bg-black">
                    <p class="font-mono text-xs uppercase tracking-widest text-stone/50">
                      [DEV: Add videoId in src/content/leaks/{lesson.id}]
                    </p>
                  </div>
                )}
              </div>
            </details>
          );
        })}
      </div>
    </div>
  </section>

  <!-- WhatsApp follow-up note + bootcamp CTA -->
  <section class="section bg-black" aria-label="Next steps">
    <div class="container mx-auto max-w-2xl text-center">
      <p class="text-stone">
        [PLACEHOLDER: One-line WhatsApp note — Sunil will follow up in 24-48 hours with extra context on each reason.]
      </p>

      <div class="mt-12 rounded-xl border border-sand/20 bg-black-2 p-8">
        <p class="eyebrow mb-3">Want the full 60-day fix?</p>
        <h2 class="headline text-3xl">Join the bootcamp</h2>
        <p class="mt-3 text-stone">
          [PLACEHOLDER: 1-2 sentences. The free mini-course shows you the reasons. The bootcamp fixes them with structure, accountability, and Sunil watching your form for 60 days.]
        </p>
        <div class="mt-6">
          {SITE.batchStatus === 'open' ? (
            <CTAButton href={waLink('Dai, I want to join the bootcamp.')} target="_blank" rel="noopener noreferrer">
              Join Batch 1
            </CTAButton>
          ) : (
            <CTAButton href="/#pricing">
              See Bootcamp Details
            </CTAButton>
          )}
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* Remove the native details marker across all browsers */
  .lesson-card > summary::-webkit-details-marker { display: none; }
  .lesson-card > summary { marker: none; }
</style>

<script>
  // Accordion: when one card opens, close all others.
  // Lazy-load Vimeo iframes — set src from data-src only when card is opened.
  const cards = document.querySelectorAll<HTMLDetailsElement>('.lesson-card');

  function loadIframe(card: HTMLDetailsElement) {
    const iframe = card.querySelector<HTMLIFrameElement>('iframe[data-src]');
    if (iframe && iframe.dataset.src) {
      iframe.src = iframe.dataset.src;
      delete iframe.dataset.src;
    }
  }

  cards.forEach((card) => {
    card.addEventListener('toggle', () => {
      if (card.open) {
        loadIframe(card);
        cards.forEach((other) => {
          if (other !== card && other.open) other.open = false;
        });
      }
    });
  });
</script>
