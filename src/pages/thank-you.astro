---
import PageLayout from '@/layouts/PageLayout.astro';
import { SITE } from '@/data/site';
---

<PageLayout
  title={`You're In — ${SITE.brand}`}
  description="Check your WhatsApp. Your free pull-up training is on the way."
  noIndex={true}
>
  <section class="section container mx-auto text-center">
    <p class="eyebrow mb-4">You're in</p>
    <h1 class="headline text-4xl md:text-6xl">Videos Coming</h1>
    <p class="mt-4 text-stone">Thank you page coming next phase.</p>
  </section>
</PageLayout>
