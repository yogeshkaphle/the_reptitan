---
import PageLayout from '@/layouts/PageLayout.astro';
import { SITE, waLink } from '@/data/site';
import Badge from '@/components/ui/Badge.astro';
import CTAButton from '@/components/ui/CTAButton.astro';

// Vimeo video IDs — replace with real IDs when videos are ready
const videos = [
  { number: 1, title: 'Knee Bend', vimeoId: '' },
  { number: 2, title: 'Momentum', vimeoId: '' },
  { number: 3, title: 'Lat Engagement', vimeoId: '' },
  { number: 4, title: 'Grip', vimeoId: '' },
  { number: 5, title: 'Perfectionism', vimeoId: '' },
];
---

<PageLayout
  title={`You're In — ${SITE.brand}`}
  description="Check your WhatsApp. Your free pull-up training is on the way."
  noIndex={true}
>
  <!-- Confirmation -->
  <section class="section bg-black" aria-label="Confirmation">
    <div class="container mx-auto max-w-2xl text-center">
      <Badge variant="sand" class="mb-4">You're in</Badge>
      <h1 class="headline text-4xl sm:text-5xl md:text-6xl">
        Videos on<br />the way
      </h1>
      <p class="mt-5 text-stone">
        [PLACEHOLDER: Confirmation message. Warm, direct. Tell them to check WhatsApp — the videos will arrive there. Also available below to watch now.]
      </p>
      <p class="mt-3 text-sm text-stone/60">
        Didn't get it? DM <a href={SITE.instagram} class="text-sand hover:underline" target="_blank" rel="noopener noreferrer">@the_reptitan</a> on Instagram.
      </p>
    </div>
  </section>

  <!-- Video embeds -->
  <section class="section bg-black-2" aria-label="The 5 leak videos">
    <div class="container mx-auto">
      <p class="eyebrow mb-8 text-center">The 5 leaks — watch now</p>

      <div class="space-y-12">
        {videos.map((v) => (
          <div>
            <div class="mb-3 flex items-baseline gap-3">
              <span class="font-mono text-2xl text-blood tabular-nums">{String(v.number).padStart(2, '0')}</span>
              <h2 class="headline text-2xl">{v.title}</h2>
            </div>

            {v.vimeoId ? (
              <div class="aspect-video-16-9 overflow-hidden rounded-lg bg-black">
                <iframe
                  src={`https://player.vimeo.com/video/${v.vimeoId}?dnt=1&badge=0&autopause=0&player_id=0&app_id=58479&title=0&byline=0&portrait=0`}
                  class="h-full w-full"
                  frameborder="0"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                  title={`Leak ${v.number}: ${v.title}`}
                />
              </div>
            ) : (
              <div class="flex aspect-video-16-9 items-center justify-center rounded-lg border border-dashed border-white/20 bg-black">
                <p class="font-mono text-xs uppercase tracking-widest text-stone/50">
                  [DEV: Add Vimeo ID for video {v.number} in src/pages/thank-you.astro]
                </p>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WhatsApp follow-up note -->
  <section class="section bg-black" aria-label="Next steps">
    <div class="container mx-auto max-w-2xl text-center">
      <p class="text-stone">
        [PLACEHOLDER: One-line WhatsApp note — Sunil will follow up in 24-48 hours with extra context on each leak.]
      </p>

      <!-- Soft bootcamp CTA -->
      <div class="mt-12 rounded-xl border border-sand/20 bg-black-2 p-8">
        <p class="eyebrow mb-3">Want the full 60-day fix?</p>
        <h2 class="headline text-3xl">Join the bootcamp</h2>
        <p class="mt-3 text-stone">
          [PLACEHOLDER: 1-2 sentences. The free videos show you the leaks. The bootcamp fixes them with structure, accountability, and Sunil watching your form for 60 days.]
        </p>
        <div class="mt-6">
          {SITE.batchStatus === 'open' ? (
            <CTAButton href={waLink('Dai, I want to join the bootcamp.')} target="_blank" rel="noopener noreferrer">
              Join Batch 1
            </CTAButton>
          ) : (
            <CTAButton href="/#pricing">
              See Bootcamp Details
            </CTAButton>
          )}
        </div>
      </div>
    </div>
  </section>
</PageLayout>
