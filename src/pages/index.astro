---
import PageLayout from '@/layouts/PageLayout.astro';
import { SITE, currentCTA } from '@/data/site';

import Hero from '@/components/sections/Hero.astro';
import PlateauPain from '@/components/sections/PlateauPain.astro';
import SunilArc from '@/components/sections/SunilArc.astro';
import BootcampOverview from '@/components/sections/BootcampOverview.astro';
import WhyThisWorks from '@/components/sections/WhyThisWorks.astro';
import WhatYouGet from '@/components/sections/WhatYouGet.astro';
import WhoItsFor from '@/components/sections/WhoItsFor.astro';
import Guarantee from '@/components/sections/Guarantee.astro';
import WhatIf from '@/components/sections/WhatIf.astro';
import Pricing from '@/components/sections/Pricing.astro';
import LeadMagnetSoftCTA from '@/components/sections/LeadMagnetSoftCTA.astro';
import FAQ from '@/components/sections/FAQ.astro';
import AboutBlock from '@/components/sections/AboutBlock.astro';
import CTAButton from '@/components/ui/CTAButton.astro';
import MobileCTABar from '@/components/layout/MobileCTABar.astro';
// All batch-state copy, hrefs, and messages come from currentCTA.
const footerWaMessage = currentCTA.whatsappMsg;
const barCopy = currentCTA.primaryLabel;
const barHref = currentCTA.primaryHref;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: SITE.bootcamp.name,
  description: `${SITE.bootcamp.durationDays}-day pull-up bootcamp by ${SITE.coach}. Break through your plateau in 60 days.`,
  provider: {
    '@type': 'Person',
    name: SITE.coach,
    url: SITE.personalSite,
  },
  url: `https://${SITE.domain}`,
};
---

<PageLayout
  title={`${SITE.brand} — Add 5-10 Reps to Your Pull-Up Max in 60 Days`}
  description="Pull-up bootcamp by Guinness world record holder Sunil Khadka. Stuck at 15-30 reps? Break through your plateau in 60 days. Kathmandu, Nepal."
  schema={schema}
  waMessage={footerWaMessage}
>
  <Hero />
  <PlateauPain />
  <SunilArc />
  <BootcampOverview />
  <WhyThisWorks />
  <WhatYouGet />
  <WhoItsFor />
  <Guarantee />
  <WhatIf />
  <Pricing />
  <LeadMagnetSoftCTA />
  <FAQ page="home" />
  <AboutBlock />

  <!-- Final CTA -->
  <section id="final-cta" class="section bg-black" aria-label="Final call to action">
    <div class="container mx-auto max-w-2xl text-center">
      <h2 class="headline text-4xl sm:text-5xl md:text-6xl">
        One bar. Sixty days. Your number moves or I keep <span class="text-blood">coaching.</span>
      </h2>
      <p class="mt-5 text-stone">
        Founding Batch is 30 spots. After that the price doubles and the next Batch is months away.
      </p>
      <div class="mt-8 flex flex-col items-center gap-4">
        <CTAButton href={currentCTA.primaryHref}>
          {currentCTA.primaryLabel}
        </CTAButton>

        <p class="text-sm text-stone">
          {currentCTA.subLine}
        </p>

        <a
          href="/why-youre-stuck"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md border border-sand/40 bg-transparent px-6 py-4 font-mono text-sm uppercase tracking-wide text-bone transition-colors hover:border-sand hover:text-sand"
        >
          Free Mini Course &rarr;
        </a>
      </div>
    </div>
  </section>

  <MobileCTABar href={barHref} label={barCopy} hideSelector="#final-cta" />
</PageLayout>
