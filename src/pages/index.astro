---
import PageLayout from '@/layouts/PageLayout.astro';
import { SITE } from '@/data/site';

import Hero from '@/components/sections/Hero.astro';
import PlateauPain from '@/components/sections/PlateauPain.astro';
import SunilArc from '@/components/sections/SunilArc.astro';
import BootcampOverview from '@/components/sections/BootcampOverview.astro';
import WhyThisWorks from '@/components/sections/WhyThisWorks.astro';
import WhatYouGet from '@/components/sections/WhatYouGet.astro';
import WhoItsFor from '@/components/sections/WhoItsFor.astro';
import Guarantee from '@/components/sections/Guarantee.astro';
import WhatIf from '@/components/sections/WhatIf.astro';
import Pricing from '@/components/sections/Pricing.astro';
import LeadMagnetSoftCTA from '@/components/sections/LeadMagnetSoftCTA.astro';
import FAQ from '@/components/sections/FAQ.astro';
import AboutBlock from '@/components/sections/AboutBlock.astro';
import CTAButton from '@/components/ui/CTAButton.astro';
import MobileCTABar from '@/components/layout/MobileCTABar.astro';
import { waLink } from '@/data/site';

// Fixed mobile bottom bar — primary CTA per batch state (mirrors Hero routing).
const barCopy = {
  'pre-launch': 'Join the Waitlist',
  'open':       'Join Batch 1',
  'closed':     'Join Waitlist for Batch 2',
}[SITE.batchStatus];
const barHref = {
  'pre-launch': '/why-youre-stuck?source=waitlist',
  'open':       '#enroll',
  'closed':     '/why-youre-stuck?source=waitlist-b2',
}[SITE.batchStatus];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: SITE.bootcamp.name,
  description: `${SITE.bootcamp.durationDays}-day pull-up bootcamp by ${SITE.coach}. Break through your plateau in 60 days.`,
  provider: {
    '@type': 'Person',
    name: SITE.coach,
    url: SITE.personalSite,
  },
  url: `https://${SITE.domain}`,
};
---

<PageLayout
  title={`${SITE.brand} — Add 5-10 Reps to Your Pull-Up Max in 60 Days`}
  description="Pull-up bootcamp by Guinness world record holder Sunil Khadka. Stuck at 15-30 reps? Break through your plateau in 60 days. Kathmandu, Nepal."
  schema={schema}
>
  <Hero />
  <PlateauPain />
  <SunilArc />
  <BootcampOverview />
  <WhyThisWorks />
  <WhatYouGet />
  <WhoItsFor />
  <Guarantee />
  <WhatIf />
  <Pricing />
  <LeadMagnetSoftCTA />
  <FAQ page="home" />
  <AboutBlock />

  <!-- Final CTA -->
  <section class="section bg-black" aria-label="Final call to action">
    <div class="container mx-auto max-w-2xl text-center">
      <h2 class="headline text-4xl sm:text-5xl md:text-6xl">
        [PLACEHOLDER: Final hook — one line, sharp, names the outcome]
      </h2>
      <p class="mt-5 text-stone">
        [PLACEHOLDER: 1-2 sentences. Last push. What changes if they do this vs. not.]
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        {SITE.batchStatus === 'open' ? (
          <CTAButton href={waLink()} target="_blank" rel="noopener noreferrer">
            Join Batch 1
          </CTAButton>
        ) : (
          <CTAButton href="/why-youre-stuck">
            Start with the Free Training
          </CTAButton>
        )}
      </div>
    </div>
  </section>

  <MobileCTABar href={barHref} label={barCopy} />
</PageLayout>
