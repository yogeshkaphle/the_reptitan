---
import PageLayout from '@/layouts/PageLayout.astro';
import { SITE } from '@/data/site';
---

<PageLayout
  title={`Why You're Stuck at Your Pull-Up Max — Free Training by ${SITE.coach}`}
  description="The 5 leaks killing your reps. Free video training from Guinness pull-up world record holder Sunil Khadka."
>
  <section class="section container mx-auto text-center">
    <p class="eyebrow mb-4">Free training</p>
    <h1 class="headline text-4xl md:text-6xl">Why You're Stuck</h1>
    <p class="mt-4 text-stone">Lead magnet sections coming next phase.</p>
  </section>
</PageLayout>
