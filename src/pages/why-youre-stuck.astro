---
import PageLayout from '@/layouts/PageLayout.astro';
import { SITE } from '@/data/site';
import LeadMagnetForm from '@/components/sections/LeadMagnetForm.astro';
import WhatsInside from '@/components/sections/WhatsInside.astro';
import FAQ from '@/components/sections/FAQ.astro';
import Badge from '@/components/ui/Badge.astro';
---

<PageLayout
  title={`Why You're Stuck at Your Pull-Up Max — Free Mini Course by ${SITE.coach}`}
  description="7 short lessons. The reasons your pull-up reps stopped moving. Free mini-course from Guinness world record holder Sunil Khadka."
>
  <!-- Hero + Form -->
  <section class="section bg-black" aria-label="Lead magnet hero">
    <div class="container mx-auto">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start">

        <!-- Left: copy -->
        <div>
          <Badge variant="blood" class="mb-4">Free Mini Course</Badge>
          <h1 class="headline text-4xl sm:text-5xl md:text-6xl">
            Why you're stuck at your<br />
            <span class="text-blood">pull-up max</span>
          </h1>
          <p class="mt-5 text-lg text-stone">
            A free mini course. Why your reps stopped moving and what to do next.
          </p>

          <!-- Proof -->
          <div class="mt-8 flex items-center gap-4 rounded-lg border border-white/10 bg-black-2 p-4">
            <img
              src="/sunil-hero.jpg"
              alt={SITE.coach}
              class="h-12 w-12 rounded-full object-cover object-top"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
            />
            <div>
              <p class="font-medium text-bone">{SITE.coach}</p>
              <p class="text-sm text-stone">Guinness World Record — {(2530).toLocaleString()}+ pull-ups</p>
            </div>
          </div>
        </div>

        <!-- Right: form -->
        <div class="rounded-xl border border-white/10 bg-black-2 p-6 md:p-8">
          <p class="eyebrow mb-5">Get me the mini course for free</p>
          <LeadMagnetForm />
        </div>

      </div>
    </div>
  </section>

  <!-- What's Inside -->
  <WhatsInside />

  <!-- Mini credibility -->
  <section class="section bg-black" aria-label="Why this works">
    <div class="container mx-auto max-w-2xl text-center">
      <Badge variant="sand" class="mb-4">Why listen to Sunil?</Badge>
      <h2 class="headline text-3xl sm:text-4xl">
        [PLACEHOLDER: Short credibility headline — e.g. "4 reps to world record"]
      </h2>
      <p class="mt-5 text-stone">
        [PLACEHOLDER: 2 sentences. Sunil started at 4 reps. He figured out what nobody was teaching. These 7 lessons are what he wishes existed when he started.]
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <FAQ page="magnet" />

  <!-- Soft bridge to bootcamp -->
  <section class="section bg-black-2" aria-label="Bridge to bootcamp">
    <div class="container mx-auto max-w-2xl text-center">
      <p class="eyebrow mb-3">Ready to go deeper?</p>
      <h2 class="headline text-3xl sm:text-4xl">
        The bootcamp goes all the way
      </h2>
      <p class="mt-5 text-stone">
        [PLACEHOLDER: 1-2 sentences. The free mini-course shows you the reasons. The bootcamp fixes them over 60 days with Sunil watching your form. Here's what's inside.]
      </p>
      <a
        href="/#pricing"
        class="mt-6 inline-block font-mono text-sm uppercase tracking-wide text-sand transition-colors hover:text-sand-dim"
      >
        See bootcamp details &rarr;
      </a>
    </div>
  </section>
</PageLayout>
