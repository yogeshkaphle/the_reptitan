---
import PageLayout from '@/layouts/PageLayout.astro';
import { SITE } from '@/data/site';
import LeadMagnetForm from '@/components/sections/LeadMagnetForm.astro';
import WhatsInside from '@/components/sections/WhatsInside.astro';
import FAQ from '@/components/sections/FAQ.astro';
import MobileCTABar from '@/components/layout/MobileCTABar.astro';
---

<PageLayout
  title={`Why You're Stuck at Your Pull-Up Max — Free Mini Course by ${SITE.coach}`}
  description="A free mini course on why your pull-up reps stalled and what to fix — plus a bonus breakdown of the real week Sunil trained before his world record."
  waMessage="Brother, I want to get the free mini course."
  minimalFooter={true}
>
  <!-- Hero + Form -->
  <section class="section bg-black" aria-label="Lead magnet hero">
    <div class="container mx-auto">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start">

        <!-- Left: copy -->
        <div>
          <p class="eyebrow mb-4">Free Mini Course + Bonus Week</p>
          <h1 class="headline text-4xl sm:text-5xl md:text-6xl">
            Why you're stuck at your<br />
            <span class="text-blood">pull-up max</span>
          </h1>
          <p class="mt-5 text-lg text-stone">
            A free mini course on why your reps stopped moving — plus the real week I trained before my world record.
          </p>

          <!-- Proof -->
          <div class="mt-8 flex items-center gap-4 rounded-lg border border-white/10 bg-black-2 p-4">
            <img
              src="/sunil-hero.jpg"
              alt={SITE.coach}
              class="h-12 w-12 rounded-full object-cover object-top"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
            />
            <div>
              <p class="font-medium text-bone">By {SITE.coach}</p>
              <p class="text-sm text-stone">Guinness World Record — 32+ clap pull-ups in a minute</p>
            </div>
          </div>
        </div>

        <!-- Right: form -->
        <div id="lead-form" class="scroll-mt-24 rounded-xl border border-white/10 bg-black-2 p-6 md:p-8">
          <p class="eyebrow mb-5">Get the mini course + bonus week — free</p>
          <LeadMagnetForm />
        </div>

      </div>
    </div>
  </section>

  <!-- What's Inside -->
  <WhatsInside />

  <!-- Mini credibility -->
  <section class="section bg-black" aria-label="Why this works">
    <div class="container mx-auto max-w-2xl text-center">
      <p class="eyebrow mb-4">Why listen to Sunil?</p>
      <h2 class="headline text-3xl sm:text-4xl">
        From 4 reps to a world record
      </h2>
      <div class="mt-5 space-y-4 text-stone">
        <p>I started with four sloppy reps on a college goalpost. Bent knees, body swinging. The same mistakes you're probably making now.</p>
        <p>I figured out what nobody was teaching me. These 7 Lessons are what I wish existed when I was stuck.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <FAQ page="magnet" />

  <!-- Soft bridge to bootcamp -->
  <section class="section bg-black-2" aria-label="Bridge to bootcamp">
    <div class="container mx-auto max-w-2xl text-center">
      <p class="eyebrow mb-3">Ready to go deeper?</p>
      <h2 class="headline text-3xl sm:text-4xl">
        The Bootcamp goes all the way
      </h2>
      <p class="mt-5 text-stone">
        The mini course shows you why you're stuck. The Bootcamp fixes it. 60 days, my eyes on your form every week, your max moves or I keep coaching.
      </p>
      <a
        href="/#pricing"
        class="mt-6 inline-block font-mono text-sm uppercase tracking-wide text-sand transition-colors hover:text-sand-dim"
      >
        See bootcamp details &rarr;
      </a>
    </div>
  </section>

  <MobileCTABar href="#lead-form" label="Get the Mini Course" watchSelector="#lead-form" />
</PageLayout>
