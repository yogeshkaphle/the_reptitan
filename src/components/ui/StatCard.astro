---
interface Props {
  number: string;
  label: string;
  accent?: boolean;
}
const { number, label, accent = false } = Astro.props;
---

<div class="flex flex-col items-start gap-1 rounded-lg border border-white/10 bg-black-2 p-5">
  <span class={`font-display text-4xl uppercase leading-none ${accent ? 'text-blood' : 'text-sand'}`}>
    {number}
  </span>
  <span class="font-mono text-xs uppercase tracking-widest text-stone">{label}</span>
</div>
