---
interface Props {
  href: string;
  label: string;
  target?: string;
  rel?: string;
  watchSelector?: string;
}
const { href, label, target, rel, watchSelector } = Astro.props;
---

<div
  id="mobile-cta-bar"
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-white/10 bg-black/95 p-3 transition-transform duration-300 ease-out md:hidden"
  aria-hidden="true"
  data-watch={watchSelector ?? '[aria-label="Hero"]'}
>
  <a
    href={href}
    target={target}
    rel={rel}
    class="flex w-full items-center justify-center gap-2 rounded-md bg-sand px-6 py-3.5 font-mono text-sm font-medium uppercase tracking-wide text-black transition-transform active:scale-95"
  >
    {label}
  </a>
</div>

<style is:global>
  @media (max-width: 767px) {
    body.cta-bar-visible { padding-bottom: 4.75rem; }
  }
</style>

<script>
  const bar = document.getElementById('mobile-cta-bar') as HTMLElement | null;
  if (bar) {
    const selector = bar.dataset.watch ?? '[aria-label="Hero"]';
    const sentinel = document.querySelector(selector);

    const show = () => {
      bar.classList.remove('translate-y-full');
      bar.setAttribute('aria-hidden', 'false');
      document.body.classList.add('cta-bar-visible');
    };
    const hide = () => {
      bar.classList.add('translate-y-full');
      bar.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('cta-bar-visible');
    };

    if (sentinel) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          entry.isIntersecting ? hide() : show();
        },
        { threshold: 0 }
      );
      observer.observe(sentinel);
    } else {
      show();
    }
  }
</script>
