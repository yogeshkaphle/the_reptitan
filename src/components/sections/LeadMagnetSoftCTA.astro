---
import Button from '@/components/ui/Button.astro';
---

<section class="section bg-black-2" aria-label="Free training offer">
  <div class="container mx-auto max-w-2xl text-center">
    <p class="eyebrow mb-4">Free Mini Course</p>
    <h2 class="headline text-3xl sm:text-4xl md:text-5xl">
      Not ready for the<br />bootcamp yet?
    </h2>
    <p class="mt-5 text-stone">
      Start free. Find out why your reps stalled and what to fix first.
    </p>
    <div class="mt-8">
      <Button href="/why-youre-stuck" variant="ghost" size="lg">
        Get the Free Mini Course &rarr;
      </Button>
    </div>
  </div>
</section>
