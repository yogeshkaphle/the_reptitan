---
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
---

<section class="section bg-black-2" aria-label="Free training offer">
  <div class="container mx-auto max-w-2xl text-center">
    <Badge variant="stone" class="mb-4">Not ready yet?</Badge>
    <h2 class="headline text-3xl sm:text-4xl md:text-5xl">
      Start with the<br />free training
    </h2>
    <p class="mt-5 text-stone">
      [PLACEHOLDER: 1-2 sentences. If the bootcamp feels like a big step, start here. 5 lessons, free, no commitment. You'll know exactly which reasons are costing you reps.]
    </p>
    <div class="mt-8">
      <Button href="/why-youre-stuck" size="lg">
        Get the Free Lessons
      </Button>
    </div>
  </div>
</section>
