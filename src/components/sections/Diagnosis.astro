---
import { getCollection } from 'astro:content';
import LeakCard from '@/components/ui/LeakCard.astro';

// Show only the 5 core reason lessons on the home page
const leaks = (await getCollection('leaks'))
  .filter(l => l.data.number !== undefined)
  .sort((a, b) => (a.data.number ?? 0) - (b.data.number ?? 0));
---

<section class="section bg-black" aria-label="The 5 reasons">
  <div class="container mx-auto">
    <div class="mb-12 max-w-2xl">
      <p class="eyebrow mb-4">The real reason</p>
      <h2 class="headline text-4xl sm:text-5xl md:text-6xl">
        5 <span class="text-blood">reasons</span> your<br />reps stall
      </h2>
      <p class="mt-5 text-stone">
        [PLACEHOLDER: 1-2 sentences. Reframe: it's not your strength or your training volume. These five reasons are costing you 5-10 reps every single set.]
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {leaks.map((leak) => (
        <LeakCard
          number={leak.data.number}
          title={leak.data.title}
          teaser={leak.data.teaser}
          displayLabel={leak.data.displayLabel}
        />
      ))}
    </div>

    <p class="mt-8 text-sm text-stone/70">
      [PLACEHOLDER: One-line bridge — "Fix these and you'll see reps move in the first week."]
    </p>
  </div>
</section>
