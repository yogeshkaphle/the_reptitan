---
import { SITE, CTA_STATES } from '@/data/site';
import CTAButton from '@/components/ui/CTAButton.astro';

const { copy: primaryCopy, href: primaryHref, reassurance } = CTA_STATES[SITE.batchStatus];
---

<section
  class="relative flex min-h-[90svh] flex-col justify-end overflow-hidden bg-black pb-16 pt-24 md:pt-32"
  aria-label="Hero"
>
  <!-- Background texture overlay -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black" aria-hidden="true"></div>

  <!-- Hero image (swap when photo arrives) -->
  <img
    src="/sunil-hero.jpg"
    alt="Sunil Khadka doing pull-ups"
    class="absolute inset-0 h-full w-full object-cover object-top opacity-30"
    fetchpriority="high"
    decoding="async"
    onerror="this.style.display='none'"
  />

  <div class="container relative mx-auto">
    <!-- Eyebrow — short on mobile, full on desktop; never wraps -->
    <p class="eyebrow mb-5 whitespace-nowrap text-[0.7rem] sm:text-xs">
      <span class="sm:hidden">Batch 1 · July 20</span>
      <span class="hidden sm:inline">60-Day Bootcamp · Batch 1 · July 20</span>
    </p>

    <!-- Headline -->
    <h1 class="headline max-w-3xl text-5xl leading-none sm:text-6xl md:text-7xl lg:text-8xl">
      Stuck at your<br /><span class="text-blood">pull-up max?</span>
    </h1>

    <!-- Sub-headline -->
    <p class="mt-6 max-w-xl text-base text-stone sm:text-lg">
      15, 20, 27 reps. Doesn't matter where you're stuck. Add 5 to 10 reps to your max in 60 days. World record holder watching your form every week.
    </p>

    <!-- Trust line -->
    <p class="mt-3 font-mono text-xs text-stone/60">
      Built by Sunil Khadka. Guinness World Record, clap pull-ups, June 21, 2025.
    </p>

    <!-- CTA row — solid primary + ghost/outline secondary, both in all states -->
    <div class="mt-8 flex flex-col items-stretch gap-4 sm:flex-row sm:items-center">
      <CTAButton href={primaryHref}>
        {primaryCopy}
      </CTAButton>

      <!-- Mobile-only: reassurance glued to primary CTA, before secondary -->
      <p class="text-sm text-stone sm:hidden">
        {reassurance}
      </p>

      <a
        href="/why-youre-stuck"
        class="inline-flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-md border border-sand/40 bg-transparent px-6 py-4 font-mono text-sm uppercase tracking-wide text-bone transition-colors hover:border-sand hover:text-sand sm:w-auto"
      >
        Free Mini Course &rarr;
      </a>
    </div>

    <!-- Desktop-only: reassurance below the CTA row -->
    <p class="mt-4 hidden text-sm text-stone sm:block">
      {reassurance}
    </p>

    <!-- Proof strip -->
    <div class="mt-12 flex flex-wrap gap-8 border-t border-white/10 pt-8">
      <div>
        <p class="font-display text-3xl text-sand">32+</p>
        <p class="font-mono text-xs uppercase tracking-widest text-stone">clap pull-ups / min — world record</p>
      </div>
      <div>
        <p class="font-display text-3xl text-sand">{SITE.bootcamp.durationDays}</p>
        <p class="font-mono text-xs uppercase tracking-widest text-stone">days to break your plateau</p>
      </div>
      <div>
        <p class="font-display text-3xl text-sand">{SITE.bootcamp.batchCap}</p>
        <p class="font-mono text-xs uppercase tracking-widest text-stone">spots per batch</p>
      </div>
    </div>
  </div>
</section>
