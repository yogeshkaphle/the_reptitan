---
import { getCollection } from 'astro:content';
import { SITE, BATCH, fmtDate } from '@/data/site';

interface Props {
  page: 'home' | 'magnet';
}
const { page } = Astro.props;

const homeFaqs = [
  {
    q: 'How do I pay?',
    a: "You can pay by eSewa or bank transfer. Once your payment comes through, you get your access and you're in.",
  },
  {
    q: `When does Batch ${BATCH.number} start, and when does the founding price end?`,
    a: `Batch ${BATCH.number} starts ${fmtDate(BATCH.startDate)}. The founding price holds until ${BATCH.cap} people are in, or ${fmtDate(BATCH.foundingDeadline)}, whichever comes first. After that it's the standard price. No fake timer. When the ${BATCH.cap} spots fill, founding's done.`,
  },
  {
    q: 'Where does the Bootcamp run?',
    a: 'Everything lives in one place. The Lessons, your weekly Drops, and where you send your Form Checks. No chasing links across five apps. You get access the day you join.',
  },
  {
    q: 'What do I need to take part?',
    a: 'A pull-up bar and a way to add weight. A dip belt is ideal, but a backpack loaded with books or a sturdy bag works fine to start. That\'s it. No gym membership needed.',
  },
  {
    q: 'Is this personal coaching or a group?',
    a: "It's a Batch, not 1-on-1. You train with a group on the same 60-day path, and every week I review your Form Check personally. So you get my eyes on your form without paying 1-on-1 rates. The program also scales to your own number, so you're never stuck doing a beginner's reps or a monster's.",
  },
  {
    q: 'What if my number doesn\'t move?',
    a: 'You did the work and your max didn\'t budge by Day 60? Then I give you 30 more days, one on one with me, free. One condition. You completed your weekly Missions, the Form Checks and Progress Checks. Do your part, and I don\'t leave you stuck.',
  },
];

const magnetFaqs = page === 'magnet'
  ? (await getCollection('faqs'))
      .filter(f => f.data.page === 'magnet')
      .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  : [];
---

<section class="bg-black py-16 md:py-24" aria-label="FAQ">
  <div class="container mx-auto max-w-3xl">

    <p class="eyebrow mb-4">Questions</p>
    <h2 class="headline text-4xl sm:text-5xl md:text-6xl">
      Before you join
    </h2>

    {page === 'home' ? (
      <div class="mt-10 space-y-3">
        {homeFaqs.map(({ q, a }) => (
          <details class="group border-b border-white/10 py-4 open:border-sand/30">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-sand">
              <span>{q}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 text-sand transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-base text-bone">{a}</p>
          </details>
        ))}
      </div>
    ) : magnetFaqs.length === 0 ? (
      <p class="mt-10 text-stone">[PLACEHOLDER: Add FAQ entries in src/content/faqs/ with page: "magnet"]</p>
    ) : (
      <div class="mt-10 space-y-3">
        {magnetFaqs.map(async (faq) => {
          const { Content } = await faq.render();
          return (
            <details class="group border-b border-white/10 py-4 open:border-sand/30">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-sand">
                <span>{faq.data.question}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 text-sand transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="prose-sm prose-invert mt-3 max-w-none text-bone">
                <Content />
              </div>
            </details>
          );
        })}
      </div>
    )}

  </div>
</section>
