---
import { SITE } from '@/data/site';
import CTAButton from '@/components/ui/CTAButton.astro';
---

<form
  action={SITE.formEndpoint || '#'}
  method="POST"
  class="flex flex-col gap-4"
  aria-label="Free mini course signup form"
>
  <!-- Captures ?source= from the URL (waitlist / waitlist-b2) via the script below -->
  <input type="hidden" id="lm-source" name="source" value="" />

  <div>
    <label for="lm-name" class="mb-1.5 block font-mono text-xs uppercase tracking-widest text-stone">
      Name
    </label>
    <input
      id="lm-name"
      name="name"
      type="text"
      required
      autocomplete="name"
      placeholder="timro naam"
      class="w-full rounded-md border border-white/15 bg-black-2 px-4 py-3 text-bone placeholder:text-stone/40 focus:border-sand focus:outline-none focus:ring-1 focus:ring-sand"
    />
  </div>

  <div>
    <label for="lm-whatsapp" class="mb-1.5 block font-mono text-xs uppercase tracking-widest text-stone">
      WhatsApp Number
    </label>
    <input
      id="lm-whatsapp"
      name="whatsapp"
      type="tel"
      required
      autocomplete="tel"
      placeholder="98XXXXXXXX"
      class="w-full rounded-md border border-white/15 bg-black-2 px-4 py-3 text-bone placeholder:text-stone/40 focus:border-sand focus:outline-none focus:ring-1 focus:ring-sand"
    />
  </div>

  <div>
    <label for="lm-email" class="mb-1.5 block font-mono text-xs uppercase tracking-widest text-stone">
      Email
    </label>
    <input
      id="lm-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="timro@email.com"
      class="w-full rounded-md border border-white/15 bg-black-2 px-4 py-3 text-bone placeholder:text-stone/40 focus:border-sand focus:outline-none focus:ring-1 focus:ring-sand"
    />
  </div>

  <div>
    <label for="lm-current-max" class="mb-1.5 block font-mono text-xs uppercase tracking-widest text-stone">
      Your current max pull-ups
    </label>
    <select
      id="lm-current-max"
      name="current_max"
      required
      class="w-full rounded-md border border-white/15 bg-black-2 px-4 py-3 text-bone focus:border-sand focus:outline-none focus:ring-1 focus:ring-sand"
    >
      <option value="" disabled selected class="text-stone/40">Select your max</option>
      <option value="Under 5">Under 5</option>
      <option value="5-10">5-10</option>
      <option value="11-15">11-15</option>
      <option value="16-20">16-20</option>
      <option value="21-25">21-25</option>
      <option value="26-30">26-30</option>
      <option value="30+">30+</option>
    </select>
  </div>

  {!SITE.formEndpoint && (
    <p class="text-xs text-stone/50">
      [DEV: Form endpoint not set. Add SITE.formEndpoint in src/data/site.ts to activate submissions.]
    </p>
  )}

  <CTAButton type="submit" class="mt-2">
    Send me the mini course
  </CTAButton>

  <p class="text-center text-xs text-stone/50">
    No spam. Lessons sent via WhatsApp.
  </p>

  <p class="text-center text-xs text-sand">
    Signing up also puts you on the waitlist for the next 60-Day Pull-Up Bootcamp.
  </p>
</form>

<script>
  // Carry the waitlist source tag from the URL into the form payload.
  const params = new URLSearchParams(window.location.search);
  const src = params.get('source');
  if (src) {
    const el = document.getElementById('lm-source') as HTMLInputElement | null;
    if (el) el.value = src;
  }
</script>
