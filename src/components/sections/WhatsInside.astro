---
import LeakCard from '@/components/ui/LeakCard.astro';
import Badge from '@/components/ui/Badge.astro';

const lessons = [
  { displayLabel: 'Welcome',  title: 'Welcome',          teaser: '' },
  { displayLabel: 'Lesson 1', title: 'Warm-Up',          teaser: '' },
  { displayLabel: 'Lesson 2', title: 'Core Engagement',  teaser: '' },
  { displayLabel: 'Lesson 3', title: 'Momentum',         teaser: '' },
  { displayLabel: 'Lesson 4', title: 'Lat Engagement',   teaser: '' },
  { displayLabel: 'Lesson 5', title: 'Grip',             teaser: '' },
  { displayLabel: 'Lesson 6', title: 'Perfectionism',    teaser: '' },
  { displayLabel: 'Lesson 7', title: 'Recovery',         teaser: '' },
];
---

<section class="section bg-black-2" aria-label="What's inside the free training">
  <div class="container mx-auto">
    <Badge variant="sand" class="mb-4">7 lessons</Badge>
    <h2 class="headline mb-3 text-4xl sm:text-5xl">
      What's inside
    </h2>
    <p class="mb-10 text-stone">
      Welcome, warm-up, the 5 reasons your reps stalled, and a recovery lesson to round it out.
    </p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {lessons.map((lesson) => (
        <LeakCard
          title={lesson.title}
          teaser={lesson.teaser || undefined}
          displayLabel={lesson.displayLabel}
        />
      ))}
    </div>
  </div>
</section>
