---
import Badge from '@/components/ui/Badge.astro';
import { SITE } from '@/data/site';

const inclusions = [
  { label: `${SITE.bootcamp.durationDays}-day structured program`, detail: 'Drop + Form + Challenge Missions every week.' },
  { label: 'Weekly form feedback', detail: '[PLACEHOLDER: How feedback is delivered — video review, DM, WhatsApp group, etc.]' },
  { label: 'Live Q&A calls', detail: '[PLACEHOLDER: Frequency and format. e.g. Bi-weekly group calls.]' },
  { label: `Day ${SITE.bootcamp.dayOfTest} max test`, detail: 'Coached max rep test on Day 58. You\'ll know your number.' },
  { label: `Day ${SITE.bootcamp.dayOfGroupCall} group call`, detail: 'Final group session — review, celebrate, next steps.' },
  { label: 'WhatsApp community access', detail: 'Batch group for the full 60 days.' },
  { label: 'Reason audit lesson library', detail: 'All 5 reason correction lessons, available from Day 1.' },
];
---

<section class="section bg-black" aria-label="What you get">
  <div class="container mx-auto">
    <div class="mb-12 max-w-2xl">
      <Badge variant="sand" class="mb-4">What's included</Badge>
      <h2 class="headline text-4xl sm:text-5xl md:text-6xl">
        Everything in<br />the bootcamp
      </h2>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      {inclusions.map((item) => (
        <div class="flex gap-4 rounded-lg border border-white/10 bg-black-2 p-5">
          <span class="mt-0.5 flex-shrink-0 text-sand" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <div>
            <p class="font-medium text-bone">{item.label}</p>
            <p class="mt-0.5 text-sm text-stone">{item.detail}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
